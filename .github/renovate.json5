// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new release of
// what Stellwerk builds on, plus the "Dependency Dashboard" issue listing what is open. Their own
// pull requests: Syncthing (crates/engine/src/pin.rs, the one version agent, hub and tests run
// with), the zig toolchain the Linux agents are cross-built with, Bun (image and package.json) and
// the cargo-chef of the image. Rust (rust:1-bookworm, dtolnay stable) floats on purpose.
// Everything else (the other packages, the actions, the images) comes with the shared settings of
// firsttris/workflows (renovate/default.json5): minor and patch updates once a month in one pull
// request that merges itself when CI is green, majors on request in the dashboard.
// Check with `bunx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>firsttris/workflows//renovate/default.json5"],
  customManagers: [
    {
      // Syncthing: Renovate changes SYNCTHING_VERSION only; the workflow syncthing-pin.yml then
      // sets the SHA-256 of every platform's archive and the version in the file's doc link and
      // tests on the Renovate branch. The demo fixtures show the same version in the screenshots.
      customType: "regex",
      managerFilePatterns: ["/^crates/engine/src/pin\\.rs$/", "/^web/src/demo/(api|fixtures)\\.ts$/"],
      matchStrings: [
        'SYNCTHING_VERSION: &str = "(?<currentValue>v\\d+\\.\\d+\\.\\d+)"',
        'syncthingVersion: "(?<currentValue>v\\d+\\.\\d+\\.\\d+)"',
      ],
      depNameTemplate: "syncthing/syncthing",
      datasourceTemplate: "github-releases",
      // v2.1.7; release candidates (v2.1.7-rc.1) do not match and are left out
      versioningTemplate: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      // `pip install ziglang==… cargo-zigbuild==…` in agents.yml, pinned so a new zig cannot
      // break a release build
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/agents\\.yml$/"],
      matchStrings: ["(?<depName>ziglang|cargo-zigbuild)==(?<currentValue>[^\\s]+)"],
      datasourceTemplate: "pypi",
    },
    {
      // `cargo install cargo-chef --version x.y.z` in docker/Dockerfile
      customType: "regex",
      managerFilePatterns: ["/^docker/Dockerfile$/"],
      matchStrings: ["cargo install cargo-chef --version (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "cargo-chef",
      datasourceTemplate: "crate",
    },
  ],
  packageRules: [
    {
      // Rust floats on purpose (rust:1-bookworm); the distroless runtime (cc-debian12:nonroot)
      // has no version tag and moves with the next Debian by hand, together with the builder.
      // Stellwerk's own image moves with its releases.
      matchPackageNames: ["rust", "docker.io/tristanteu/**", "tristanteu/**"],
      enabled: false,
    },
    {
      matchPackageNames: ["syncthing/syncthing"],
      groupName: "Syncthing",
      sourceUrl: "https://github.com/syncthing/syncthing",
      commitMessageTopic: "Syncthing",
      prBodyNotes: [
        "Agent, hub and the integration tests run this one release (`crates/engine/src/pin.rs`). `syncthing-pin.yml` sets the SHA-256 of every archive from the release's `sha256sum.txt.asc` on this branch and starts CI, whose Rust job downloads it on Linux, Windows and macOS and runs the integration tests and the service smoke test against it. Before merging: read the release notes and the changes in `lib/config` and `lib/api` since the old tag (`confighandler.go`: what `PUT`/`PATCH`/`DELETE` on `/rest/config/...` do); the reconciler (`engine::reconcile::plan`) relies on them. A new major or minor: check the defaults the engine sets and the docs that name Syncthing's behaviour. Existing installations get the new Syncthing only with the next Stellwerk release (docs/installation.md, Updates).",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      matchPackageNames: ["ziglang", "cargo-zigbuild"],
      groupName: "zig cross-build",
      prBodyNotes: [
        "The static musl agents for Linux (x86_64, aarch64) are built with these. `agents.yml` does not run on pull requests: start **Actions → Agents → Run workflow** on this branch and check that both Linux agents build.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // Bun: the image's web stage (oven/bun) and packageManager in package.json in one PR, so CI
      // tests the Bun the image builds with. Renovate's npm manager reads "packageManager":
      // "bun@x.y.z" itself, as the npm package `bun` (no regex manager needed).
      matchPackageNames: ["docker.io/oven/bun", "oven/bun", "bun"],
      enabled: true,
      groupName: "Bun",
      sourceUrl: "https://github.com/oven-sh/bun",
      prBodyNotes: [
        "The image's `web` stage (`oven/bun:<version>-slim` in docker/Dockerfile) and `packageManager` in package.json (CI's `bun-version-file`, and the `npm install bun@…` of the e2e and screenshots jobs in the Playwright image) move together. Bun installs the packages and runs the scripts and the Playwright runner. CI's docker job builds and starts the image.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      matchPackageNames: ["cargo-chef"],
      sourceUrl: "https://github.com/LukeMathWalker/cargo-chef",
      commitMessageTopic: "cargo-chef",
    },
  ],
}
