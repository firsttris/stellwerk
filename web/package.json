{
  "name": "web",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale --silent",
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "preview:demo": "vite preview --outDir dist-demo --host 127.0.0.1 --strictPort --port ${PW_PORT:-4173}",
    "typecheck": "pnpm i18n && tsc --noEmit",
    "lint": "biome check .",
    "test": "pnpm i18n && vitest run",
    "check": "biome check . && pnpm typecheck && vitest run && vite build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@inlang/paraglide-js": "^2.27.0",
    "@inlang/plugin-message-format": "^4.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.43",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
